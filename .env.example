# Only needed to RECORD against the live model.
# The suite replays from checked-in fixtures without any key: `npm test`
#
# Copy to .env (or just `export` these in your shell).
GEMINI_API_KEY=your_free_key_from_aistudio.google.com

# Optional overrides
# MODEL=gemini-2.5-flash          # try gemini-flash-latest if the default 404s
# SENTINEL_DELAY_MS=1100          # gap between API calls; raise if free tier rate-limits you
# SENTINEL_REPO_URL=              # shown in the scorecard footer if set
