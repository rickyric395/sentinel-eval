{
  "name": "sentinel-eval",
  "version": "1.0.0",
  "description": "Sentinel \u2014 a reliability eval and regression gate for high-stakes AI agents. Tiered scenarios, LLM-as-judge cross-checked by deterministic assertions, pass rates over N runs, and a gate that blocks a regressing prompt.",
  "type": "module",
  "scripts": {
    "eval": "node src/evaluate.js --prompt=agent-v2",
    "eval:v1": "node src/evaluate.js --prompt=agent-v1",
    "record": "node src/evaluate.js --prompt=agent-v1 --mode=record && node src/evaluate.js --prompt=agent-v2 --mode=record",
    "gate": "node src/gate.js",
    "baseline": "node src/baseline.js",
    "test": "npm run eval --silent && npm run gate --silent",
    "results": "node src/results.js",
    "pareto": "node src/pareto.js",
    "pareto:report": "node src/pareto-report.js",
    "judge:set": "node src/judge-set.js",
    "judge:eval": "node src/judge-eval.js",
    "hinglish:report": "node src/hinglish-report.js"
  },
  "keywords": [
    "llm-eval",
    "ai-agents",
    "llm-as-judge",
    "regression-gate",
    "agent-reliability",
    "llm-testing"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
